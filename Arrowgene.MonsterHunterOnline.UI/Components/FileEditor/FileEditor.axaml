<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Arrowgene.MonsterHunterOnline.UI.Components"
             x:Class="Arrowgene.MonsterHunterOnline.UI.Components.FileEditor"
             x:DataType="local:FileEditorViewModel"
             mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TabControl.editor-tabs > TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource FgTertiary}" />
        </Style>
        <Style Selector="TabControl.editor-tabs > TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabControl.editor-tabs > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
        </Style>
        <Style Selector="TabControl.editor-tabs > TabItem:pointerover">
            <Setter Property="Foreground" Value="{StaticResource FgSecondary}" />
        </Style>
        <Style Selector="TabControl.editor-tabs > TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource FgSecondary}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource BgPage}">
        <Grid>
            <!-- Empty state -->
            <StackPanel IsVisible="{Binding !HasTabs}"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="No Files Open"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FgPrimary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select a text file in the Archive Explorer and click &quot;Edit File&quot; to open it here."
                           FontSize="12"
                           Foreground="{StaticResource FgMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="340" />
            </StackPanel>

            <!-- Editor tabs -->
            <TabControl Classes="editor-tabs"
                        ItemsSource="{Binding Tabs}"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        IsVisible="{Binding HasTabs}"
                        Margin="12">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="local:EditorTabViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TabHeader}"
                                       VerticalAlignment="Center" />
                            <Button Content="x"
                                    Click="CloseTabClick"
                                    Tag="{Binding}"
                                    Padding="4,1"
                                    MinWidth="0"
                                    MinHeight="0"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip.Tip="Close tab" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="local:EditorTabViewModel">
                        <Grid RowDefinitions="Auto,*,Auto"
                              RowSpacing="6"
                              Margin="0,8,0,0">
                            <!-- File info bar -->
                            <Border Background="{StaticResource BgSubtle}"
                                    CornerRadius="8"
                                    Padding="8,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding File.ArchivePath}"
                                               FontSize="11"
                                               Foreground="{StaticResource FgTertiary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding File.ArchivePath}" />
                                    <Button Grid.Column="1"
                                            Content="Save"
                                            Click="SaveTabClick"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding IsModified}"
                                            Padding="12,4"
                                            MinHeight="0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            ToolTip.Tip="Save changes to archive (in memory)" />
                                </Grid>
                            </Border>

                            <!-- Text editor -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource BgSurface}"
                                    BorderBrush="{StaticResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="2"
                                    MinHeight="0">
                                <TextBox Text="{Binding Content, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         FontSize="12"
                                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                         Foreground="{StaticResource FgPrimary}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="8,6"
                                         MinHeight="0"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" />
                            </Border>

                            <!-- Status bar -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource BgSubtle}"
                                    CornerRadius="8"
                                    Padding="12,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding File.ArchivePath}"
                                               FontSize="10"
                                               Foreground="{StaticResource FgMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding IsModified, StringFormat={}Modified: {0}}"
                                               FontSize="10"
                                               Foreground="{StaticResource FgMuted}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
